{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Settings",
  "type": "object",
  "properties": {
    "currency": { "type": "string" },
    "theme": { "type": "string" },
    "simulated_latency_ms": { "type": "integer" },
    "commission_percent": { "type": "number" },
    "leverage": { "type": "number" },
    "auto_clear_logs": { "type": "boolean" },
    "system_alerts": { "type": "boolean" },
    "sound_effects": { "type": "boolean" },
    "terminal_font_size": { "type": "integer" }
  },
  "required": [
    "currency", "theme", "simulated_latency_ms", "commission_percent",
    "leverage", "auto_clear_logs", "system_alerts", "sound_effects",
    "terminal_font_size"
  ]
}
